<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EnglishSteamTrainer.Core\EnglishSteamTrainer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Mitgelieferte Inhalte: Fallback, solange noch nichts online geladen wurde. -->
    <Content Include="..\..\content\**\*.*" Link="content\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Icons\*.png" />
  </ItemGroup>
</Project>
