<Window x:Class="EnglishSteamTrainer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="English Steam Trainer"
        Height="850"
        Width="1100"
        MinHeight="800"
        MinWidth="1000"
        Closing="Window_Closing"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7E8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#263238" CornerRadius="18" Padding="18">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="🎮 English Steam Trainer" Foreground="White" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Löse 10 Vokabelkarten. Danach wird Steam für heute freigeschaltet."
                               Foreground="#DDEEEE" FontSize="15"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="LevelText" Foreground="#FFE082" FontSize="18" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock x:Name="XpText" Foreground="White" FontSize="14" TextAlignment="Right"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,22,0,22" Background="White" CornerRadius="22" Padding="28">
            <StackPanel>
                <TextBlock Text="Was heißt dieses Wort auf Deutsch?" FontSize="18" Foreground="#546E7A"/>
                <TextBlock x:Name="WordText" Text="apple" FontSize="54" FontWeight="Bold" Margin="0,14,0,12"/>

                <TextBox x:Name="AnswerBox" FontSize="24" Height="48" Padding="8"
                         KeyDown="AnswerBox_KeyDown"/>

                <WrapPanel Margin="0,18,0,0">
                    <Button Content="Antwort prüfen" FontSize="18" Padding="18,8" Click="CheckAnswer_Click"/>
                    <Button Content="Tipp anzeigen" FontSize="18" Padding="18,8" Margin="12,0,0,0" Click="Hint_Click"/>
                    <Button Content="Nächste Karte" FontSize="18" Padding="18,8" Margin="12,0,0,0" Click="Next_Click"/>
                </WrapPanel>

                <TextBlock x:Name="HintText"
                           FontSize="16"
                           Foreground="#1976D2"
                           FontWeight="SemiBold"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>

                <Border x:Name="FeedbackBox"
                        Margin="0,12,0,0"
                        Padding="10"
                        Background="#EEEEEE"
                        CornerRadius="10"
                        MinHeight="45">
                    <TextBlock x:Name="FeedbackText"
                               Text="Hier erscheint gleich dein Ergebnis."
                               FontSize="16"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Border>

                <Grid Margin="0,22,0,0">
                    <ProgressBar x:Name="ProgressBar"
                 Minimum="0"
                 Maximum="10"
                 Height="34"/>

                    <TextBlock x:Name="ProgressText"
               FontSize="16"
               FontWeight="Bold"
               Foreground="#263238"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="RewardBox" Margin="0,14,0,0" Background="#E8F5E9" CornerRadius="12" Padding="10">
                    <TextBlock x:Name="RewardText"
                               Text="⭐ Sammle 10 richtige Antworten und schalte Steam frei!"
                               FontSize="16"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <Button x:Name="SteamButton" DockPanel.Dock="Right" Content="Steam starten 🚀"
                    FontSize="20" Padding="18,10" IsEnabled="False" Click="Steam_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="14" Foreground="#455A64"/>
        </DockPanel>
    </Grid>
</Window>