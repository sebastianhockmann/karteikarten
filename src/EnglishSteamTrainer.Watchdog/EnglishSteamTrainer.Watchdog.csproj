<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnglishSteamTrainer.Core\EnglishSteamTrainer.Core.csproj" />
  </ItemGroup>

  <!-- Die .exe allein startet nicht: sie braucht .dll, .runtimeconfig.json und .deps.json daneben. -->
  <Target Name="CopyToUiOutput" AfterTargets="Build">
    <ItemGroup>
      <WatchdogFiles Include="$(TargetDir)$(TargetName).exe;$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).runtimeconfig.json;$(TargetDir)$(TargetName).deps.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WatchdogFiles)"
      DestinationFolder="..\EnglishSteamTrainer.UI\bin\$(Configuration)\$(TargetFramework)\" />
  </Target>

</Project>